# EXPO_PUBLIC_* is inlined into the client bundle and readable by anyone who
# downloads the app. Only values that are safe in public belong here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where this app's own +api.ts routes are deployed (the `eas deploy` URL).
# The app and its server are two artifacts from one repo, so the client has to
# be told where the server lives. Leave empty for web, where the origin is
# implicit.
EXPO_PUBLIC_API_URL=https://your-app.expo.app

# Server-only. Read exclusively inside +api.ts / server/, set as an EAS Hosting
# environment secret, and NEVER prefixed with EXPO_PUBLIC_ — this key bypasses
# RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
